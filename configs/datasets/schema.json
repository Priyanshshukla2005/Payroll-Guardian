{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PayrollRecordSchema",
  "type": "object",
  "required": [
    "employee_id",
    "payroll_month",
    "department",
    "designation",
    "joining_date",
    "employment_status",
    "location",
    "working_days",
    "present_days",
    "leave_days",
    "basic_salary",
    "allowances",
    "overtime_hours",
    "overtime_amount",
    "bonus",
    "gross_salary",
    "pf",
    "esi",
    "tds",
    "other_deductions",
    "total_deductions",
    "net_salary"
  ],
  "properties": {
    "employee_id": {"type": "string"},
    "payroll_month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "department": {"type": "string"},
    "designation": {"type": "string"},
    "joining_date": {"type": "string", "format": "date"},
    "employment_status": {"type": "string", "enum": ["ACTIVE", "PROBATION", "NOTICE_PERIOD", "TERMINATED"]},
    "location": {"type": "string"},
    "working_days": {"type": "integer", "minimum": 1, "maximum": 31},
    "present_days": {"type": "integer", "minimum": 0, "maximum": 31},
    "leave_days": {"type": "integer", "minimum": 0, "maximum": 31},
    "basic_salary": {"type": "number", "minimum": 0},
    "allowances": {"type": "number", "minimum": 0},
    "overtime_hours": {"type": "number", "minimum": 0},
    "overtime_amount": {"type": "number", "minimum": 0},
    "bonus": {"type": "number", "minimum": 0},
    "gross_salary": {"type": "number", "minimum": 0},
    "pf": {"type": "number", "minimum": 0},
    "esi": {"type": "number", "minimum": 0},
    "tds": {"type": "number", "minimum": 0},
    "other_deductions": {"type": "number", "minimum": 0},
    "total_deductions": {"type": "number", "minimum": 0},
    "net_salary": {"type": "number", "minimum": 0},
    "is_anomaly": {"type": "integer", "enum": [0, 1]},
    "anomaly_type": {"type": "string"}
  }
}
