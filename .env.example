# AI Payroll Guardian — Enterprise Production Configuration Template (Phase 10)
# Copy this file to .env and configure environment variables. Never commit .env to version control.

# Application & API Server Settings
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database & Persistence (PostgreSQL for Production, SQLite for local dev/testing)
DATABASE_URL=sqlite:///payroll_guardian.db
# PostgreSQL Example: DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payroll_guardian

# Authentication & RBAC Security (Phase 10)
# CRITICAL: In production (APP_ENV=production), SECRET_KEY MUST be a cryptographically
# random secret (>= 32 chars). Default development secret strings are rejected on startup.
SECRET_KEY=generate_a_high_entropy_random_secret_for_production_jwt_signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# In production (APP_ENV=production), AUTH_STRICT is automatically enforced as true.
AUTH_STRICT=false

# Optional Seed User Passwords (Development only - override default passwords)
# In production, default users are NOT seeded automatically.
SEED_ADMIN_PASSWORD=AdminPassword2026!
SEED_PAYROLL_ADMIN_PASSWORD=PayrollAdmin2026!
SEED_AUDITOR_PASSWORD=Auditor2026!
SEED_VIEWER_PASSWORD=Viewer2026!

# AI Model Configuration & Versioning
AI_MODEL_VERSION=v2
MODEL_NAME=HybridPayrollDetector_v2
MODEL_THRESHOLD=0.45
FEATURE_SCHEMA_VERSION=features_v1

# RAG & Knowledge Configuration
RAG_VERSION=rag_2024_06
RAG_EMBEDDINGS_DIR=data/knowledge/embeddings
RAG_METADATA_DIR=data/knowledge/metadata
RAG_MIN_RELEVANCE_THRESHOLD=0.15

# LLM Provider Configuration (mock, openai, anthropic, gemini, ollama)
LLM_PROVIDER=mock
LLM_MODEL=mock-grounded-v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=30.0
LLM_RETRY_COUNT=2

# Provider Credentials (Required only when LLM_PROVIDER is not 'mock')
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
